  gpu_font[78] = 0x4631CD671;
  gpu_font[79] = 0x3A318C62E;
  gpu_font[80] = 0x4217C62F;
  gpu_font[81] = 0x59358C62E;
  gpu_font[82] = 0x45257C62F;
  gpu_font[83] = 0x3E107043E;
  gpu_font[84] = 0x10842109F;
