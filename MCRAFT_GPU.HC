  gt_rows[1233] = 0x374525362524336A;
  gt_rows[1234] = 0x76E2522764737523;
  gt_rows[1235] = 0x76CECA5435ECC565;
  gt_rows[1236] = 0x7AECE76446C4E643;
  gt_rows[1237] = 0x3232476243ECC543;
  gt_rows[1238] = 0x6743775535532433;
  gt_rows[1239] = 0x24443227A4556737;
  gt_rows[1240] = 0x74523656364C5554;
  gt_rows[1241] = 0x43293EED2AC75332;
  gt_rows[1242] = 0x42326DEC5CCCC5A4;
  gt_rows[1243] = 0x57754DEE7C22EEDA;
  gt_rows[1244] = 0x7534562753232D55;
  gt_rows[1245] = 0x2236A3673A25DED2;
  gt_rows[1246] = 0x255657476645677B;
  gt_rows[1247] = 0x32727A2524722643;
  for (idx = 0; idx < B_COUNT * 6 * 16; idx++)
    for (t = 0; t < 16; t++) {
      k = (gt_rows[idx] >> ((15 - t) << 2)) & 15;
      gt_tex[idx * 16 + t] = k;
    }
}

I64 GpuTexIndex(I64 blk, I64 dir, I64 tx, I64 ty)
{
  return gt_tex[(blk * 6 + dir) * 256 + ty * 16 + tx];
}

U0 GpuRect(I64 x0, I64 y0, I64 x1, I64 y1, U32 c)
{
  I64 x, y;
  if (x0 < 0) x0 = 0;
  if (y0 < 0) y0 = 0;
  if (x1 > scr_w) x1 = scr_w;
  if (y1 > scr_h) y1 = scr_h;
  for (y = y0; y < y1; y++)
    for (x = x0; x < x1; x++)
      db[y * stride + x] = c;
}

U0 GpuPixel(I64 x, I64 y, U32 c)
{
  if (x < 0 || x >= scr_w || y < 0 || y >= scr_h) return;
  db[y * stride + x] = c;
}

I64 GpuGlyphRow(U8 ch, I64 row)
{
  return (gpu_font[ch] >> (row * 5)) & 31;
}

U0 GpuChar(U8 ch, I64 x, I64 y, U32 c, I64 scale)
{
  I64 row, col, bits, px, py;
  if (ch < 32 || ch > 126) ch = 63;       // '?' as ASCII without a literal
  for (row = 0; row < 7; row++) {
    bits = GpuGlyphRow(ch, row);
    for (col = 0; col < 5; col++)
      if (bits & (1 << col))
        for (py = 0; py < scale; py++)
          for (px = 0; px < scale; px++)
            GpuPixel(x + (col + 1) * scale + px, y + row * scale + py, c);
  }
}

U0 GpuText(U8 *s, I64 x, I64 y, U32 c, I64 scale)
{
  I64 i, cx;
  cx = x;
  for (i = 0; s[i]; i++) {
    if (s[i] == ' ') cx += 6 * scale;
    else {
      GpuChar(s[i], cx, y, c, scale);
      cx += 6 * scale;
    }
  }
}

U0 GpuTextUpper(U8 *s, I64 x, I64 y, U32 c, I64 scale)
{
  I64 i, cx;
  U8 ch;
  cx = x;
  for (i = 0; s[i]; i++) {
    ch = s[i];
    if (ch >= 'a' && ch <= 'z') ch -= 32;
    if (ch == ' ') cx += 6 * scale;
    else {
      GpuChar(ch, cx, y, c, scale);
      cx += 6 * scale;
    }
  }
}

U0 GpuFontInit()
{
    gpu_font[32] = 0x0;
  gpu_font[65] = 0x4631FC62E;
  gpu_font[66] = 0x3E317C62F;
  gpu_font[67] = 0x78210843E;
